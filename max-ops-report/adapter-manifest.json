{
  "schema_version": "maxops-agent-connector/2",
  "connector_id": "user-feishu-template",
  "display_name": "MAX OPS Agent Connector",
  "runtime_neutral": true,
  "contract": "references/adapter-contract.md",
  "default_adapter": null,
  "product_routing": {
    "default_route": "feishu_base_direct",
    "explicit_adapter_selection_required": true,
    "feishu_base_direct": "cross_plan_full_route",
    "webhook_write": "capability_dependent_optional"
  },
  "adapters": {
    "webhook_write": {
      "mode": "write_only",
      "availability": "capability_dependent_optional",
      "capabilities": ["start", "progress", "blocked", "question", "artifact", "finish"],
      "cannot": ["read_task", "read_feedback", "acknowledge", "read_receipt"],
      "required_environment": ["MAXOPS_WEBHOOK_URL", "MAXOPS_WEBHOOK_TOKEN"],
      "native_feishu_receiver": {
        "requires_base_plan_webhook_trigger": true,
        "trigger_label": "接收到 Webhook 时",
        "must_confirm_before_selection": true,
        "template_copy_guarantees_endpoint_token": false,
        "missing_endpoint_state": "not_connected",
        "message_or_form_fallback": false
      }
    },
    "feishu_base_direct": {
      "mode": "full",
      "availability": "cross_plan_full_route",
      "capabilities": ["read_task", "start", "progress", "blocked", "question", "artifact", "finish", "inbox", "ack", "receipt"],
      "required_environment": [
        "MAXOPS_FEISHU_APP_ID",
        "MAXOPS_FEISHU_APP_SECRET",
        "MAXOPS_FEISHU_APP_TOKEN",
        "MAXOPS_FEISHU_TASKS_TABLE_ID",
        "MAXOPS_FEISHU_EVENTS_TABLE_ID",
        "MAXOPS_FEISHU_FEEDBACK_TABLE_ID",
        "MAXOPS_FEISHU_RECEIPTS_TABLE_ID"
      ]
    }
  },
  "common_environment": ["MAXOPS_ADAPTER", "MAXOPS_INSTANCE_ID", "MAXOPS_AGENT_ID", "MAXOPS_AGENT_NAME"],
  "event_semantics": {
    "start": { "kind": "run_started", "state": "running" },
    "progress": { "kind": "progress", "state": "running" },
    "blocked": { "kind": "blocked", "state": "blocked" },
    "question": { "kind": "question", "state": "blocked" },
    "artifact": { "kind": "artifact", "state": "done", "status": "pending_review" },
    "finish": { "kind": "run_finished", "state": "done" }
  },
  "identity": {
    "copy_scope": "MAXOPS_INSTANCE_ID",
    "task_scope": "one explicit logical task_id",
    "record_id_required": false,
    "title_inference": false,
    "board_enumeration": false,
    "agent_status_write": false
  },
  "machine_fields": [
    "instance_id", "task_id", "event_id", "idempotency_key", "payload_digest",
    "agent_id", "agent_name", "run_id", "kind", "state", "title", "detail",
    "artifact_url", "occurred_at", "message_id", "body", "reply", "status",
    "created_at", "replied_at", "receipt_id", "receipt", "submitted_at", "acknowledged_at"
  ],
  "status_enums": {
    "feedback": ["open", "replied", "processing", "resolved"],
    "receipt_ack": ["acknowledged"],
    "artifact_review": ["pending_review", "approved", "changes_requested"],
    "connector_dependencies": {
      "inbox_reads": "replied",
      "ack_receipt_writes": "acknowledged",
      "artifact_initial_write": "pending_review"
    },
    "localized_values_in_machine_status": false
  },
  "time_serialization": {
    "public_event_occurred_at": "iso8601_string_with_timezone",
    "webhook_write_event_occurred_at": "unchanged_iso8601_string",
    "feishu_base_direct_occurred_at": "epoch_milliseconds_number",
    "feishu_base_direct_submitted_at": "epoch_milliseconds_number",
    "feishu_base_direct_acknowledged_at": "epoch_milliseconds_number",
    "invalid_time_fallback": false
  },
  "authentication": {
    "environment_or_secret_store_only": true,
    "secret_cli_arguments": false,
    "secret_in_template_fields": false,
    "secret_in_urls": false,
    "secret_in_logs_or_results": false,
    "secret_in_repository": false
  },
  "idempotency": {
    "required_for_every_mutation": true,
    "scope": ["instance_id", "idempotency_key"],
    "same_key_same_payload_is_replay": true,
    "same_key_different_payload_is_conflict": true
  },
  "failure_mode": {
    "missing_configuration": "not_connected",
    "preview_fallback": false,
    "simulated_success": false
  },
  "self_check": "npm run validate && npm test && npm run lint"
}
